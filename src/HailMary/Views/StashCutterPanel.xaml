<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.StashCutterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="16,12" Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="stashcutter.stashSceneHeader" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ConnectionInfo, Mode=OneWay}" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="common.searchScene" KeyDown="SearchBox_OnKeyDown" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SearchCommand}" loc:Loc.Key="common.search" />
                    </Grid>
                    <TextBox loc:Loc.HeaderKey="common.sceneId" KeyDown="SceneIdBox_OnKeyDown" Text="{x:Bind ViewModel.SceneId, Mode=TwoWay}" />
                    <StackPanel Spacing="8">
                        <Button
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.LoadSceneCommand}"
                            loc:Loc.Key="common.load" />
                        <Button
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.LoadFromSessionCommand}"
                            loc:Loc.Key="common.lastScene"
                            loc:Loc.ToolTipKey="stash.lastSceneTooltip" />
                        <Button
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Click="ClipboardButton_Click"
                            loc:Loc.Key="common.clipboard" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="stash.resultsHint" />
                    <ListView
                        x:Name="ResultsList"
                        MinHeight="120"
                        MaxHeight="280"
                        DoubleTapped="ResultsList_OnDoubleTapped"
                        ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="ResultsList_OnSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:StashSceneRowViewModel" xmlns:viewModels="using:HailMary.ViewModels">
                                <TextBlock FontFamily="Consolas" Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        FontFamily="Consolas"
                        Text="{x:Bind ViewModel.LoadedSummary, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />
                    <Button Command="{x:Bind ViewModel.OpenInStashCommand}" loc:Loc.Key="common.inStash" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,12,12,8">
                <ContentControl
                    x:Name="PreviewHost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
            </Border>
            <Border
                Grid.Row="1"
                Margin="16,0,12,12"
                Style="{StaticResource ToolShellCard}"
                VerticalAlignment="Stretch">
                <ContentControl
                    x:Name="CutterContentHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <Border
            Grid.Column="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <ContentControl
                x:Name="SettingsHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
