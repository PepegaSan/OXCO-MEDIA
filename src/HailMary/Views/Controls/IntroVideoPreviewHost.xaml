<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.IntroVideoPreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:controls="using:HailMary.Views.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    IsTabStop="True"
    KeyDown="RootHost_KeyDown"
    mc:Ignorable="d" xmlns:loc="using:HailMary.Services">

    <StackPanel HorizontalAlignment="Stretch" Spacing="8" drop:VideoDrop.AllowFolders="True" drop:VideoDrop.IsEnabled="True">
        <controls:AspectFitVideoPresenter
            x:Name="VideoSurface"
            HorizontalAlignment="Stretch"
            MaxPreviewHeight="480"
            MinPreviewHeight="180" />

        <controls:VideoRangeTimeline
            x:Name="RangeTimeline"
            DurationSeconds="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
            PositionSeconds="{x:Bind ViewModel.SliderValue, Mode=OneWay}"
            Peaks="{x:Bind ViewModel.WaveformPeaks, Mode=OneWay}"
            Spans="{x:Bind ViewModel.TimelineRanges, Mode=OneWay}" />

        <StackPanel Spacing="6">
            <Slider
                x:Name="TimelineSlider"
                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Consolas" Text="{x:Bind ViewModel.PositionDisplay, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CutSummary, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontFamily="Consolas"
                    Text="{x:Bind ViewModel.DurationDisplay, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    x:Name="BtnPlayPause"
                    Width="40"
                    Height="34"
                    Padding="0"
                    Click="BtnPlayPause_Click"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    loc:Loc.ToolTipKey="common.play">
                    <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    Width="40"
                    Height="34"
                    Padding="0"
                    Click="BtnStop_Click"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    loc:Loc.ToolTipKey="common.stopButton">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE71A;" />
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button Command="{x:Bind ViewModel.SetIntroFromPositionCommand}" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" loc:Loc.ToolTipKey="intro.setIntroHereTooltip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE892;" />
                        <TextBlock loc:Loc.Key="intro.setIntroHere" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.SetOutroFromPositionCommand}" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" loc:Loc.ToolTipKey="intro.setOutroHereTooltip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock loc:Loc.Key="intro.setOutroHere" />
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE893;" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="6,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button Command="{x:Bind ViewModel.SeekToIntroEndCommand}" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.Key="intro.seekIntroEnd" />
                <Button Command="{x:Bind ViewModel.SeekToOutroStartCommand}" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.Key="intro.seekOutroStart" />
            </StackPanel>
        </Grid>
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.7"
            loc:Loc.Key="intro.shortcutHint"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
