<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.PerfectLoopPreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    mc:Ignorable="d"
    KeyDown="RootHost_KeyDown">

    <StackPanel HorizontalAlignment="Stretch" Spacing="8" drop:VideoDrop.AllowFolders="True" drop:VideoDrop.IsEnabled="True">
        <controls:AspectFitVideoPresenter
            x:Name="VideoSurface"
            HorizontalAlignment="Stretch"
            MaxPreviewHeight="480"
            MinPreviewHeight="180" />

        <controls:VideoRangeTimeline
            x:Name="RangeTimeline"
            DurationSeconds="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
            PositionSeconds="{x:Bind ViewModel.SliderValue, Mode=OneWay}"
            Peaks="{x:Bind ViewModel.WaveformPeaks, Mode=OneWay}"
            Spans="{x:Bind ViewModel.TimelineRanges, Mode=OneWay}" />

        <StackPanel Spacing="6">
            <Slider
                x:Name="TimelineSlider"
                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Consolas" Text="{x:Bind ViewModel.PositionDisplay, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.RangeSummary, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontFamily="Consolas"
                    Text="{x:Bind ViewModel.DurationDisplay, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
            <Button Click="BtnPlay_Click" loc:Loc.Key="common.play" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
            <Button Click="BtnPause_Click" loc:Loc.Key="common.pause" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
            <Button Click="BtnStop_Click" loc:Loc.Key="common.stopButton" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
            <Button Click="BtnMarkIn_Click" loc:Loc.Key="common.markIn" IsEnabled="{x:Bind ViewModel.CanMarkRange, Mode=OneWay}" />
            <Button Click="BtnMarkOut_Click" loc:Loc.Key="common.markOut" IsEnabled="{x:Bind ViewModel.CanMarkRange, Mode=OneWay}" />
            <Button
                Command="{x:Bind ViewModel.ResetLoopRangeCommand}"
                loc:Loc.Key="perfectloop.resetRange"
                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
            <Button
                Command="{x:Bind ViewModel.FindBestLoopInRangeCommand}"
                loc:Loc.Key="perfectloop.findBest"
                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.PreviewHint, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            loc:Loc.Key="perfectloop.rangeHint"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
