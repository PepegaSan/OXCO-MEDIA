<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.SceneCutterScenesPanel"
    x:Name="RootPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HailMary.Models"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Padding="12,8,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                Style="{StaticResource ToolShellSectionHeader}"
                loc:Loc.Key="cutter.scenesHeader" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.TogglePartialSelectModeCommand}"
                    Content="{x:Bind ViewModel.PartialSelectButtonText, Mode=OneWay}" />
                <CheckBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    loc:Loc.Key="cutter.chronologicalSort"
                    IsChecked="{x:Bind ViewModel.ChronologicalSort, Mode=TwoWay}" />
            </Grid>
            <Button
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.ClearScenesCommand}"
                loc:Loc.Key="cutter.clearScenes" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.Scenes, Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Auto"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SceneEntry">
                    <Border
                        Padding="10,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                Visibility="{Binding ElementName=RootPanel, Path=ViewModel.ShowSceneCheckboxes, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Display, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        FontFamily="Consolas"
                                        KeyDown="ScenePosition_KeyDown"
                                        PlaceholderText="#"
                                        Tag="{x:Bind}"
                                        Text="{x:Bind PositionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        LostFocus="SceneTime_LostFocus"
                                        loc:Loc.PlaceholderKey="actionBar.start"
                                        Tag="{x:Bind}"
                                        Text="{x:Bind StartInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Column="2"
                                        FontFamily="Consolas"
                                        LostFocus="SceneTime_LostFocus"
                                        loc:Loc.PlaceholderKey="common.end"
                                        Tag="{x:Bind}"
                                        Text="{x:Bind EndInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                <Button Click="MoveSceneUp_Click" Content="↑" Tag="{x:Bind}" />
                                <Button Click="MoveSceneDown_Click" Content="↓" Tag="{x:Bind}" />
                                <Button Click="SeekScene_Click" Content="▶" Tag="{x:Bind}" />
                                <Button Click="RemoveScene_Click" Content="×" Tag="{x:Bind}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
