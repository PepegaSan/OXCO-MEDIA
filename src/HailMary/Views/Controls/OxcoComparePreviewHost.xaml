<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.OxcoComparePreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    KeyDown="RootHost_KeyDown"
    mc:Ignorable="d">

    <Border Style="{StaticResource ToolShellCard}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title + transport + view toggles -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" loc:Loc.ToolTipKey="oxco.keyboardHint">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.preview" />
                    <FontIcon VerticalAlignment="Center" FontSize="12" Glyph="&#xE946;" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.PreviewJumpPrevCutCommand}" Content="⏮" loc:Loc.ToolTipKey="oxco.tip.prevCut" />
                    <Button Command="{x:Bind ViewModel.PreviewStepBackCommand}" Content="◀" />
                    <Button MinWidth="72" Command="{x:Bind ViewModel.TogglePreviewPlayCommand}" Content="{x:Bind ViewModel.PreviewPlayButtonText, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.PreviewStepForwardCommand}" Content="▶" />
                    <Button Command="{x:Bind ViewModel.PreviewJumpNextCutCommand}" Content="⏭" loc:Loc.ToolTipKey="oxco.tip.nextCut" />
                    <Button Command="{x:Bind ViewModel.LoadPreviewCommand}" loc:Loc.ToolTipKey="oxco.tip.reloadPreview">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{x:Bind ViewModel.PreviewSideBySide, Mode=TwoWay}" loc:Loc.Key="oxco.sideBySide" />
                    <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{x:Bind ViewModel.PreviewOverlay, Mode=TwoWay}" loc:Loc.Key="oxco.diffOverlay" />
                    <NumberBox
                        Width="96"
                        VerticalAlignment="Center"
                        Maximum="60"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.PreviewMaxFps, Mode=TwoWay}"
                        loc:Loc.ToolTipKey="oxco.maxFps" />
                </StackPanel>
            </Grid>

            <!-- Image -->
            <Grid Grid.Row="1">
                <controls:AspectFitImagePresenter
                    HorizontalAlignment="Stretch"
                    ImageSource="{x:Bind ViewModel.PreviewImage, Mode=OneWay}"
                    MaxPreviewHeight="560"
                    MinPreviewHeight="200" />
                <ProgressRing
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.PreviewIsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.PreviewIsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    loc:Loc.Key="oxco.preview.pickPair"
                    Visibility="{x:Bind ViewModel.PreviewIsLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
            </Grid>

            <!-- Result timeline: metric curve, threshold, kept/cut strip, playhead -->
            <controls:OxcoResultTimeline
                Grid.Row="2"
                EmptyText="{x:Bind ViewModel.TimelineEmptyText, Mode=OneWay}"
                FrameCount="{x:Bind ViewModel.PreviewFrameTotal, Mode=OneWay}"
                Metric="{x:Bind ViewModel.TimelineMetric, Mode=OneWay}"
                MetricOffset="{x:Bind ViewModel.TimelineMetricOffset, Mode=OneWay}"
                PixelMax="{x:Bind ViewModel.TimelinePixelMax, Mode=OneWay}"
                PositionFrame="{x:Bind ViewModel.PreviewFrameIndex, Mode=OneWay}"
                SeekRequested="Timeline_SeekRequested"
                Segments="{x:Bind ViewModel.TimelineSegments, Mode=OneWay}"
                Threshold="{x:Bind ViewModel.TimelineThreshold, Mode=OneWay}" />

            <!-- Info -->
            <Grid Grid.Row="3" ColumnSpacing="12" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.TimelineInfoText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBlock FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PreviewDiffText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PreviewSwapText, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PreviewInfoText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PreviewTimeText, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
