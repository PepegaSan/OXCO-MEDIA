<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.OxcoComparePreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:controls="using:HailMary.Views.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    KeyDown="RootHost_KeyDown"
    mc:Ignorable="d" xmlns:loc="using:HailMary.Services">

    <controls:ToolSplitLayout SettingsWidth="360">
        <controls:ToolSplitLayout.Main>
            <Grid Padding="16,12,12,8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <Button Command="{x:Bind ViewModel.LoadPreviewCommand}" loc:Loc.Key="common.load" />
                    <Button Command="{x:Bind ViewModel.TogglePreviewPlayCommand}" Content="{x:Bind ViewModel.PreviewPlayButtonText, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" loc:Loc.Key="oxco.maxFps" />
                    <NumberBox
                        Width="64"
                        Maximum="60"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.PreviewMaxFps, Mode=TwoWay}" />
                    <CheckBox loc:Loc.Key="oxco.sideBySide" IsChecked="{x:Bind ViewModel.PreviewSideBySide, Mode=TwoWay}" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <controls:AspectFitImagePresenter
                        HorizontalAlignment="Stretch"
                        MaxPreviewHeight="640"
                        MinPreviewHeight="180"
                        ImageSource="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" />
                    <ProgressRing
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.PreviewIsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.PreviewIsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#CCCCCC"
                        loc:Loc.Key="oxco.noVideoClickLoad"
                        Visibility="{x:Bind ViewModel.PreviewIsLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                </Grid>
                <controls:VideoRangeTimeline
                    Grid.Row="2"
                    DurationSeconds="{x:Bind ViewModel.PreviewDurationSeconds, Mode=OneWay}"
                    PositionSeconds="{x:Bind ViewModel.PreviewPositionSeconds, Mode=OneWay}"
                    Peaks="{x:Bind ViewModel.PreviewWaveformPeaks, Mode=OneWay}"
                    SeekRequested="PreviewTimeline_SeekRequested" />
                <StackPanel Grid.Row="3" Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PreviewInfoText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="oxco.keyboardHint" />
                </StackPanel>
            </Grid>
        </controls:ToolSplitLayout.Main>
        <controls:ToolSplitLayout.Settings>
            <StackPanel Padding="16,12" Spacing="12">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="audiocleaner.filesHeader" />
                    </Expander.Header>
                    <StackPanel Padding="0,8,0,0" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" loc:Loc.HeaderKey="oxco.previewOriginalLabel" Text="{x:Bind ViewModel.PreviewPathA, Mode=TwoWay}" drop:VideoDrop.IsEnabled="True" drop:VideoDrop.PathPropertyName="PreviewPathA" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickPreviewPathACommand}" loc:Loc.Key="common.addDots" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" loc:Loc.HeaderKey="oxco.previewDeepfakeLabel" Text="{x:Bind ViewModel.PreviewPathB, Mode=TwoWay}" drop:VideoDrop.IsEnabled="True" drop:VideoDrop.PathPropertyName="PreviewPathB" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickPreviewPathBCommand}" loc:Loc.Key="common.addDots" />
                        </Grid>
                        <CheckBox loc:Loc.Key="oxco.linkWorkflow" IsChecked="{x:Bind ViewModel.PreviewLinkPaths, Mode=TwoWay}" />
                        <CheckBox loc:Loc.Key="oxco.autoLoad" IsChecked="{x:Bind ViewModel.PreviewAutoLoad, Mode=TwoWay}" />
                        <Button Command="{x:Bind ViewModel.SyncPreviewFromWorkflowNowCommand}" loc:Loc.Key="oxco.syncNow" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="oxco.previewLinkHintFull" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Expander>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="oxco.testDiffSection" />
                    </Expander.Header>
                    <StackPanel Padding="0,8,0,0" Spacing="8">
                        <TextBlock loc:Loc.Key="oxco.noise" />
                        <Slider Maximum="80" Minimum="1" Value="{x:Bind ViewModel.PreviewNoise, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PreviewNoise, Mode=OneWay}" />
                        <TextBlock loc:Loc.Key="oxco.pixelThreshold" />
                        <Slider Maximum="4000" Minimum="1" Value="{x:Bind ViewModel.PreviewPixel, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PreviewPixel, Mode=OneWay}" />
                        <CheckBox loc:Loc.Key="oxco.diffOverlay" IsChecked="{x:Bind ViewModel.PreviewOverlay, Mode=TwoWay}" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PreviewDiffText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PreviewSwapText, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.ApplyPreviewToFiltersCommand}" loc:Loc.Key="oxco.toFilterTab" HorizontalAlignment="Left" />
                        <Button Command="{x:Bind ViewModel.SavePreviewThresholdsCommand}" loc:Loc.Key="oxco.saveThresholds" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </controls:ToolSplitLayout.Settings>
    </controls:ToolSplitLayout>
</UserControl>
