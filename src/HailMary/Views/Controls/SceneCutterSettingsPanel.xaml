<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.SceneCutterSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12" Spacing="10">
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.paths" />
                </Expander.Header>
                <StackPanel Padding="0,8,0,0" Spacing="10">
                    <Grid ColumnSpacing="8" drop:VideoDrop.IsEnabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            loc:Loc.HeaderKey="common.video"
                            loc:Loc.PlaceholderKey="cutter.videoPlaceholder"
                            Text="{x:Bind ViewModel.InputPath, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.PickInputFileCommand}"
                            loc:Loc.Key="common.file" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            loc:Loc.HeaderKey="cutter.outputDirHeader"
                            Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.PickOutputDirCommand}"
                            loc:Loc.Key="common.addDots" />
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.export" />
                </Expander.Header>
                <StackPanel Padding="0,8,0,0" Spacing="10">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            loc:Loc.HeaderKey="common.codec"
                            ItemsSource="{x:Bind ViewModel.CodecOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCodec, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            loc:Loc.HeaderKey="common.targetFps"
                            Minimum="0"
                            Maximum="240"
                            SmallChange="1"
                            LargeChange="5"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.TargetFps, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        loc:Loc.Key="common.targetFpsHint"
                        TextWrapping="WrapWholeWords" />
                    <CheckBox loc:Loc.Key="cutter.safeOutput" IsChecked="{x:Bind ViewModel.SafeOutput, Mode=TwoWay}" />
                    <CheckBox loc:Loc.Key="cutter.autoRemoveExported" IsChecked="{x:Bind ViewModel.AutoRemoveExported, Mode=TwoWay}" />
                    <CheckBox loc:Loc.Key="cutter.useDavinciExport" IsChecked="{x:Bind ViewModel.UseDavinciExport, Mode=TwoWay}" />
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind ViewModel.UseDavinciExport, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <CheckBox
                            loc:Loc.Key="cutter.replaceOriginalWithCut"
                            loc:Loc.ToolTipKey="cutter.replaceOriginalHint"
                            IsChecked="{x:Bind ViewModel.ReplaceOriginalWithCut, Mode=TwoWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            loc:Loc.Key="cutter.replaceOriginalHint"
                            TextWrapping="WrapWholeWords" />
                        <TextBox
                            loc:Loc.HeaderKey="cutter.ffmpegOutputDir"
                            loc:Loc.PlaceholderKey="cutter.ffmpegOutputDirPlaceholder"
                            Text="{x:Bind ViewModel.FfmpegOutputDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.UseDavinciExport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBox loc:Loc.HeaderKey="cutter.resolvePreset" Text="{x:Bind ViewModel.DavinciPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox loc:Loc.HeaderKey="cutter.davinciOutputDir" Text="{x:Bind ViewModel.DavinciOutputDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
