<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.MarkerUpdaterVideoPreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:HailMary.Converters"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:models="using:HailMary.Models"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    mc:Ignorable="d"
    KeyDown="RootHost_KeyDown">

    <UserControl.Resources>
        <conv:SecondsDisplayConverter x:Key="SecondsDisplayConverter" />
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Stretch" Spacing="8">
        <controls:AspectFitVideoPresenter
            x:Name="VideoSurface"
            HorizontalAlignment="Stretch"
            MaxPreviewHeight="460"
            MinPreviewHeight="180" />

        <controls:VideoRangeTimeline
            x:Name="RangeTimeline"
            DurationSeconds="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
            PositionSeconds="{x:Bind ViewModel.SliderValue, Mode=OneWay}"
            Peaks="{x:Bind ViewModel.WaveformPeaks, Mode=OneWay}"
            Spans="{x:Bind ViewModel.TimelineRanges, Mode=OneWay}" />

        <StackPanel Spacing="2">
            <Slider
                x:Name="TimelineSlider"
                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.PositionDisplay, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Opacity="0.75"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.MarkerMarks, Mode=OneWay}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" Text="{x:Bind ViewModel.DurationDisplay, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <!-- Transport + marker range -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Width="36" Height="34" Padding="0" Click="BtnBackCoarse_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.backCoarseTooltip">
                    <FontIcon FontSize="13" Glyph="&#xEB9E;" />
                </Button>
                <Button Width="36" Height="34" Padding="0" Click="BtnBackFine_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.backFineTooltip">
                    <FontIcon FontSize="13" Glyph="&#xED3C;" />
                </Button>
                <Button
                    x:Name="BtnPlayPause"
                    Width="44"
                    Height="34"
                    Padding="0"
                    Click="BtnPlayPause_Click"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    loc:Loc.ToolTipKey="markerupdater.playPauseTooltip">
                    <FontIcon x:Name="PlayPauseIcon" FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button Width="36" Height="34" Padding="0" Click="BtnForwardFine_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.forwardFineTooltip">
                    <FontIcon FontSize="13" Glyph="&#xED3D;" />
                </Button>
                <Button Width="36" Height="34" Padding="0" Click="BtnForwardCoarse_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.forwardCoarseTooltip">
                    <FontIcon FontSize="13" Glyph="&#xEB9D;" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <Button Click="BtnMarkIn_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.markInTooltip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE892;" />
                        <TextBlock loc:Loc.Key="markerupdater.markIn" />
                    </StackPanel>
                </Button>
                <Button Click="BtnMarkOut_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.markOutTooltip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock loc:Loc.Key="markerupdater.markOut" />
                        <FontIcon FontSize="12" Glyph="&#xE893;" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <ComboBox
                    MinWidth="78"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.SpeedChoices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PlaybackSpeed, Mode=TwoWay}"
                    loc:Loc.ToolTipKey="markerupdater.speedHeader">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding}" /><Run Text="×" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Width="36" Height="34" Padding="0" loc:Loc.ToolTipKey="markerupdater.stepSettingsTooltip">
                    <FontIcon FontSize="13" Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="260" Spacing="10">
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    loc:Loc.HeaderKey="markerupdater.fineHeader"
                                    ItemsSource="{x:Bind ViewModel.FineStepChoices, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.FineStepSeconds, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SecondsDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    loc:Loc.HeaderKey="markerupdater.coarseHeader"
                                    ItemsSource="{x:Bind ViewModel.CoarseStepChoices, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.CoarseStepSeconds, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SecondsDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Opacity="0.75" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" loc:Loc.Key="markerupdater.shortcutsFull" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Quick markers: one click / shortcut creates a marker with a preset -->
        <Border
            Padding="10,8"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="6">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE945;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" loc:Loc.Key="markerupdater.quickHeader" />
                        <TextBlock VerticalAlignment="Center" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="markerupdater.quickPickHint" />
                    </StackPanel>
                    <Button Grid.Column="1" Padding="8,3" loc:Loc.Key="markerupdater.quickManage">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="380" Spacing="10">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" loc:Loc.Key="markerupdater.quickManageHeader" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.QuickPresets, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MarkerQuickPreset">
                                                <Grid Padding="0,2" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontFamily="Consolas" Opacity="0.7" Text="{x:Bind SlotText}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{x:Bind Label}" />
                                                        <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{x:Bind PrimaryTag}" /><Run Text="  ·  " /><Run Text="{x:Bind Title}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Padding="6" Click="RemovePreset_Click" Tag="{x:Bind}" loc:Loc.ToolTipKey="markerupdater.quickPresetRemoveTooltip">
                                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <MenuFlyoutSeparator />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="markerupdater.quickPresetNew" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox loc:Loc.HeaderKey="markerupdater.quickPresetLabel" Text="{x:Bind ViewModel.NewQuickPresetLabel, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            loc:Loc.HeaderKey="markerupdater.quickPresetSlot"
                                            ItemsSource="{x:Bind ViewModel.QuickPresetSlotChoices, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.NewQuickPresetSlot, Mode=TwoWay}" />
                                        <ComboBox
                                            Grid.Row="1"
                                            HorizontalAlignment="Stretch"
                                            loc:Loc.HeaderKey="markerupdater.quickPresetTag"
                                            IsEditable="True"
                                            ItemsSource="{x:Bind ViewModel.AllTagNames, Mode=OneWay}"
                                            Text="{x:Bind ViewModel.NewQuickPresetTag, Mode=TwoWay}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" loc:Loc.HeaderKey="markerupdater.quickPresetTitle" Text="{x:Bind ViewModel.NewQuickPresetTitle, Mode=TwoWay}" />
                                        <Button
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.AddQuickPresetCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            loc:Loc.Key="markerupdater.quickPresetAdd" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <ListView
                    x:Name="PresetChips"
                    ItemsSource="{x:Bind ViewModel.QuickPresets, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectedIndex="{x:Bind ViewModel.ActiveQuickPresetIndex, Mode=OneWay}"
                    SelectionChanged="PresetChips_OnSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="10,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MarkerQuickPreset">
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{x:Bind PrimaryTag}">
                                <TextBlock Text="{x:Bind Label}" />
                                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Opacity="0.6" Text="{x:Bind SlotText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Click="BtnQuickPoint_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" loc:Loc.ToolTipKey="markerupdater.quickPointTooltip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7C1;" />
                            <TextBlock loc:Loc.Key="markerupdater.quickPoint" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnQuickIn_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.quickInTooltip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE892;" />
                            <TextBlock loc:Loc.Key="markerupdater.quickRangeStart" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnQuickOut_Click" IsEnabled="{x:Bind ViewModel.HasQuickRangeStart, Mode=OneWay}" loc:Loc.ToolTipKey="markerupdater.quickOutTooltip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock loc:Loc.Key="markerupdater.quickRangeEnd" />
                            <FontIcon FontSize="12" Glyph="&#xE893;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
