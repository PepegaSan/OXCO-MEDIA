<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.ToolSplitLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid SizeChanged="Layout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SettingsColumn" Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="PaneSelector" Grid.ColumnSpan="2" Margin="16,4" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <RadioButton x:Name="MainPaneButton" IsChecked="True" Click="PaneButton_Click" loc:Loc.Key="shell.toolPane" />
            <RadioButton x:Name="SettingsPaneButton" Click="PaneButton_Click" loc:Loc.Key="actionBar.settingsTooltip" />
        </StackPanel>

        <ContentPresenter
            x:Name="MainPresenter"
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <Border
            x:Name="SettingsPane"
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter
                    x:Name="SettingsPresenter"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
