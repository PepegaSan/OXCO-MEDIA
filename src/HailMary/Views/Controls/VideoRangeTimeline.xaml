<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.VideoRangeTimeline"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="72"
    HorizontalAlignment="Stretch"
    SizeChanged="Root_OnSizeChanged">

    <Grid
        x:Name="HitGrid"
        Background="#22FFFFFF"
        PointerPressed="HitGrid_OnPointerPressed"
        PointerMoved="HitGrid_OnPointerMoved"
        PointerReleased="HitGrid_OnPointerReleased"
        PointerCanceled="HitGrid_OnPointerCanceled"
        PointerCaptureLost="HitGrid_OnPointerCaptureLost">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4" />
        <Canvas x:Name="WaveformLayer" IsHitTestVisible="False" />
        <Canvas x:Name="RangesLayer" IsHitTestVisible="False" />
        <Rectangle
            x:Name="Playhead"
            Width="2"
            HorizontalAlignment="Left"
            Fill="#E6FFFFFF"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
