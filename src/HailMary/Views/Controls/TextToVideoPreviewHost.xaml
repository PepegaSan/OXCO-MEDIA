<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.TextToVideoPreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    IsTabStop="True"
    KeyDown="RootHost_OnKeyDown"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Stretch" Spacing="8">
        <Grid x:Name="PreviewSurface" HorizontalAlignment="Left" Background="Transparent">
            <controls:AspectFitVideoPresenter
                x:Name="VideoSurface"
                HorizontalAlignment="Left"
                MaxPreviewHeight="720"
                MinPreviewHeight="320"
                Opacity="0"
                IsHitTestVisible="False" />
            <controls:AspectFitImagePresenter
                x:Name="PreviewPresenter"
                HorizontalAlignment="Left"
                MaxPreviewHeight="720"
                MinPreviewHeight="320"
                IsHitTestVisible="False" />
            <Border
                x:Name="HitLayer"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerPressed="HitLayer_OnPointerPressed"
                PointerMoved="HitLayer_OnPointerMoved"
                PointerReleased="HitLayer_OnPointerReleased"
                PointerCanceled="HitLayer_OnPointerCanceled"
                PointerCaptureLost="HitLayer_OnPointerCaptureLost" />
            <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
                <Border
                    x:Name="LayoutGhost"
                    BorderBrush="#FF4FC3F7"
                    BorderThickness="2"
                    Background="#224FC3F7"
                    Visibility="Collapsed"
                    CornerRadius="2" />
                <Border
                    x:Name="ResizeHandle"
                    Width="14"
                    Height="14"
                    Background="#FF4FC3F7"
                    BorderBrush="White"
                    BorderThickness="1"
                    Visibility="Collapsed" />
                <Border
                    x:Name="PlayGhost"
                    Visibility="Collapsed"
                    Background="#99000000"
                    Padding="6,2"
                    CornerRadius="3">
                    <TextBlock
                        x:Name="PlayGhostText"
                        Foreground="White"
                        TextWrapping="Wrap"
                        MaxWidth="520" />
                </Border>
            </Canvas>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider
                x:Name="TimelineSlider"
                Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Click="BtnPlay_Click" loc:Loc.Key="common.play" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
            <Button Click="BtnPause_Click" loc:Loc.Key="common.pause" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
            <Button Click="BtnStop_Click" loc:Loc.Key="common.stopButton" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            loc:Loc.Key="texttovideo.previewHint"
            TextWrapping="WrapWholeWords" />
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            loc:Loc.Key="texttovideo.layoutDragHint"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
