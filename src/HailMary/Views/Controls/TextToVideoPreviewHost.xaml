<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.TextToVideoPreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    IsTabStop="True"
    KeyDown="RootHost_OnKeyDown"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Stretch" Spacing="8">
        <Grid x:Name="PreviewSurface" HorizontalAlignment="Left" Background="Transparent">
            <controls:AspectFitVideoPresenter
                x:Name="VideoSurface"
                HorizontalAlignment="Left"
                MaxPreviewHeight="480"
                MinPreviewHeight="200"
                Opacity="0"
                IsHitTestVisible="False" />
            <controls:AspectFitImagePresenter
                x:Name="PreviewPresenter"
                HorizontalAlignment="Left"
                MaxPreviewHeight="480"
                MinPreviewHeight="200"
                IsHitTestVisible="False" />
            <!-- Text overlays: the exact PNGs the export burns in, positioned in video pixels. -->
            <Canvas x:Name="SpriteLayer" IsHitTestVisible="False" />
            <Border
                x:Name="HitLayer"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerPressed="HitLayer_OnPointerPressed"
                PointerMoved="HitLayer_OnPointerMoved"
                PointerReleased="HitLayer_OnPointerReleased"
                PointerCanceled="HitLayer_OnPointerCanceled"
                PointerCaptureLost="HitLayer_OnPointerCaptureLost"
                PointerExited="HitLayer_OnPointerExited" />
            <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
                <Rectangle
                    x:Name="GuideVertical"
                    Width="1"
                    Fill="#FFFF4FA3"
                    Visibility="Collapsed" />
                <Rectangle
                    x:Name="GuideHorizontal"
                    Height="1"
                    Fill="#FFFF4FA3"
                    Visibility="Collapsed" />
                <Rectangle
                    x:Name="HoverGhost"
                    Stroke="#B3FFFFFF"
                    StrokeThickness="1"
                    StrokeDashArray="3,2"
                    RadiusX="3"
                    RadiusY="3"
                    Visibility="Collapsed" />
                <Rectangle
                    x:Name="LayoutGhost"
                    Stroke="#FF4FC3F7"
                    StrokeThickness="1.5"
                    Fill="#144FC3F7"
                    RadiusX="3"
                    RadiusY="3"
                    Visibility="Collapsed" />
                <Border
                    x:Name="ResizeHandle"
                    Width="14"
                    Height="14"
                    Background="White"
                    BorderBrush="#FF4FC3F7"
                    BorderThickness="2"
                    CornerRadius="7"
                    Visibility="Collapsed" />
            </Canvas>
        </Grid>

        <controls:VideoRangeTimeline
            x:Name="RangeTimeline"
            DurationSeconds="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
            PositionSeconds="{x:Bind ViewModel.SliderValue, Mode=OneWay}"
            Peaks="{x:Bind ViewModel.WaveformPeaks, Mode=OneWay}"
            Spans="{x:Bind ViewModel.TimelineRanges, Mode=OneWay}" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Name="BtnPlayPause"
                    Width="40"
                    Height="34"
                    Padding="0"
                    Click="BtnPlayPause_Click"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    loc:Loc.ToolTipKey="common.play">
                    <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    Width="40"
                    Height="34"
                    Padding="0"
                    Click="BtnStop_Click"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    loc:Loc.ToolTipKey="common.stopButton">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE71A;" />
                </Button>
            </StackPanel>
            <Slider
                x:Name="TimelineSlider"
                Grid.Column="1"
                VerticalAlignment="Center"
                Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Text="{x:Bind ViewModel.TimeDisplay, Mode=OneWay}" />
        </Grid>

        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.8"
            loc:Loc.Key="texttovideo.layoutDragHint"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
