<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.Controls.SceneCutterVideoPreviewHost"
    x:Name="RootHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:controls="using:HailMary.Views.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    mc:Ignorable="d"
    KeyDown="RootHost_KeyDown" xmlns:loc="using:HailMary.Services">

    <StackPanel HorizontalAlignment="Stretch" Spacing="8" drop:VideoDrop.IsEnabled="True">
        <controls:AspectFitVideoPresenter
            x:Name="VideoSurface"
            HorizontalAlignment="Stretch"
            MaxPreviewHeight="480"
            MinPreviewHeight="180" />

        <controls:VideoRangeTimeline
            x:Name="RangeTimeline"
            DurationSeconds="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
            PositionSeconds="{x:Bind ViewModel.SliderValue, Mode=OneWay}"
            Peaks="{x:Bind ViewModel.WaveformPeaks, Mode=OneWay}"
            Spans="{x:Bind ViewModel.TimelineRanges, Mode=OneWay}" />

        <StackPanel Spacing="6">
            <Slider
                x:Name="TimelineSlider"
                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Consolas" Text="{x:Bind ViewModel.PositionDisplay, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.PendingMarks, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontFamily="Consolas"
                    Text="{x:Bind ViewModel.DurationDisplay, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    x:Name="BtnPlayPause"
                    Width="40"
                    Height="34"
                    Padding="0"
                    Click="BtnPlayPause_Click"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    loc:Loc.ToolTipKey="common.play">
                    <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    Width="40"
                    Height="34"
                    Padding="0"
                    Click="BtnStop_Click"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    loc:Loc.ToolTipKey="common.stopButton">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE71A;" />
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button Click="BtnMarkIn_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="cutter.markInTooltip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE892;" />
                        <TextBlock loc:Loc.Key="common.markIn" />
                    </StackPanel>
                </Button>
                <Button Click="BtnMarkOut_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" loc:Loc.ToolTipKey="cutter.markOutTooltip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock loc:Loc.Key="common.markOut" />
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE893;" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.AddSceneCommand}" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" loc:Loc.ToolTipKey="cutter.addSceneTooltip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE710;" />
                        <TextBlock loc:Loc.Key="cutter.addScene" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.AddFullVideoSceneCommand}"
                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE740;" />
                    <TextBlock loc:Loc.Key="cutter.addFullVideo" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Opacity="0.7"
            loc:Loc.Key="cutter.shortcutHint"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
