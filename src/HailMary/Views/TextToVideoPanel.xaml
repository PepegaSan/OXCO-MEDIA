<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.TextToVideoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HailMary.Models"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d" xmlns:loc="using:HailMary.Services">

    <controls:ToolSplitLayout
        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
        SettingsWidth="400">
            <controls:ToolSplitLayout.Main>
                <Grid Padding="16,12,12,12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                        <Grid ColumnSpacing="8" drop:VideoDrop.IsEnabled="True" drop:VideoDrop.PathPropertyName="VideoPath">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.videoPath" Text="{x:Bind ViewModel.VideoPath, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickVideoCommand}" loc:Loc.Key="common.addDots" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                loc:Loc.HeaderKey="texttovideo.layoutPick"
                                loc:Loc.PlaceholderKey="texttovideo.layoutPickPlaceholder"
                                ItemsSource="{x:Bind ViewModel.LayoutNames, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedLayoutName, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.ApplyLayoutCommand}"
                                IsEnabled="{x:Bind ViewModel.CanApplyLayout, Mode=OneWay}"
                                loc:Loc.Key="texttovideo.layoutApply" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.DeleteLayoutCommand}"
                                IsEnabled="{x:Bind ViewModel.CanDeleteLayout, Mode=OneWay}"
                                loc:Loc.Key="texttovideo.layoutDelete" />
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.LayoutDisplay, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.VideoInfoLine, Mode=OneWay}" />
                        <controls:TextToVideoPreviewHost ViewModel="{x:Bind ViewModel, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasVideo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource ToolShellCard}" VerticalAlignment="Stretch">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.segmentsHeader" />
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SegmentList" ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TextOverlaySegment">
                                            <Button
                                                Margin="0,0,0,4"
                                                Padding="10,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Click="SegmentItem_Click"
                                                Tag="{x:Bind}">
                                                <TextBlock Text="{x:Bind ListLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                <Button Width="40" Height="36" Command="{x:Bind ViewModel.NewSegmentCommand}" loc:Loc.ToolTipKey="texttovideo.newSegment">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE710;" />
                                </Button>
                                <Button Width="40" Height="36" Command="{x:Bind ViewModel.DuplicateSegmentCommand}" IsEnabled="{x:Bind ViewModel.IsEditingExistingSegment, Mode=OneWay}" loc:Loc.ToolTipKey="texttovideo.duplicateSegment">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8C8;" />
                                </Button>
                                <Button Width="40" Height="36" Command="{x:Bind ViewModel.DeleteSegmentCommand}" IsEnabled="{x:Bind ViewModel.IsEditingExistingSegment, Mode=OneWay}" loc:Loc.ToolTipKey="common.delete">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE738;" />
                                </Button>
                                <Button Width="40" Height="36" Command="{x:Bind ViewModel.CommitSegmentCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.CommitSegmentLabel, Mode=OneWay}">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8FB;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </controls:ToolSplitLayout.Main>
            <controls:ToolSplitLayout.Settings>
                <StackPanel Padding="16,12" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" Text="{x:Bind ViewModel.SegmentEditorTitle, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                        </Expander.Header>
                        <StackPanel Padding="0,8,0,0" Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SegmentModeHint, Mode=OneWay}" TextWrapping="WrapWholeWords" Opacity="0.85" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" AcceptsReturn="True" loc:Loc.HeaderKey="texttovideo.textHeader" MaxHeight="100" Text="{x:Bind ViewModel.EditorSegment.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PasteTextCommand}" loc:Loc.Key="common.insert" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.stylePresets" />
                                <VariableSizedWrapGrid
                                    x:Name="StylePresetPanel"
                                    ItemHeight="36"
                                    ItemWidth="166"
                                    Orientation="Horizontal" />
                            </StackPanel>
                            <ComboBox x:Name="FontCombo" HorizontalAlignment="Stretch" loc:Loc.HeaderKey="texttovideo.fontFamily" IsEditable="False" IsTextSearchEnabled="True" SelectionChanged="FontCombo_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:WindowsFontChoice" xmlns:svc="using:HailMary.Services">
                                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.fontSize" Maximum="200" Minimum="12" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EditorSegment.Fontsize, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" loc:Loc.HeaderKey="texttovideo.lineSpacing" Maximum="120" Minimum="-120" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EditorSegment.LineSpacing, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton Width="36" Height="32" Padding="0" IsChecked="{x:Bind ViewModel.EditorSegment.Bold, Mode=TwoWay}" loc:Loc.ToolTipKey="common.bold">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8DD;" />
                                </ToggleButton>
                                <ToggleButton Width="36" Height="32" Padding="0" IsChecked="{x:Bind ViewModel.EditorSegment.Italic, Mode=TwoWay}" loc:Loc.ToolTipKey="common.italic">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8DB;" />
                                </ToggleButton>
                                <ToggleButton Width="36" Height="32" Padding="0" IsChecked="{x:Bind ViewModel.EditorSegment.Strike, Mode=TwoWay}" loc:Loc.ToolTipKey="common.strike">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xEDE0;" />
                                </ToggleButton>
                                <Border Width="1" Margin="6,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <ToggleButton x:Name="AlignLeftButton" Width="36" Height="32" Padding="0" Click="AlignButton_Click" Tag="0" loc:Loc.ToolTipKey="texttovideo.alignLeft">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8E4;" />
                                </ToggleButton>
                                <ToggleButton x:Name="AlignCenterButton" Width="36" Height="32" Padding="0" Click="AlignButton_Click" Tag="1" loc:Loc.ToolTipKey="texttovideo.alignCenter">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8E3;" />
                                </ToggleButton>
                                <ToggleButton x:Name="AlignRightButton" Width="36" Height="32" Padding="0" Click="AlignButton_Click" Tag="2" loc:Loc.ToolTipKey="texttovideo.alignRight">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8E2;" />
                                </ToggleButton>
                            </StackPanel>
                            <controls:HexColorField x:Name="TextColorField" Hex="{x:Bind ViewModel.EditorSegment.Color, Mode=TwoWay}" />
                            <VariableSizedWrapGrid
                                x:Name="ColorPalettePanel"
                                HorizontalAlignment="Left"
                                ItemHeight="32"
                                ItemWidth="32"
                                MaximumRowsOrColumns="10"
                                Orientation="Horizontal" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.position" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Maximum="20000" Minimum="0" Value="{x:Bind ViewModel.EditorSegment.PosX, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Maximum="20000" Minimum="0" Value="{x:Bind ViewModel.EditorSegment.PosY, Mode=TwoWay}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Width="36" Height="32" Padding="0" Command="{x:Bind ViewModel.CenterEditorHorizontallyCommand}" loc:Loc.ToolTipKey="texttovideo.centerHorizontal">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8E3;" />
                                    </Button>
                                    <Button Width="36" Height="32" Padding="0" Command="{x:Bind ViewModel.CenterEditorVerticallyCommand}" loc:Loc.ToolTipKey="texttovideo.centerVertical">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE7FD;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.timeFromTo" TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" loc:Loc.PlaceholderKey="texttovideo.timePlaceholder" Text="{x:Bind ViewModel.EditorSegment.From, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Click="InsertFrom_Click" loc:Loc.Key="texttovideo.insertFrom" loc:Loc.ToolTipKey="texttovideo.insertFromTooltip" />
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.EditorFromTimeHint, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" loc:Loc.PlaceholderKey="texttovideo.timePlaceholder" Text="{x:Bind ViewModel.EditorSegment.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Click="InsertTo_Click" loc:Loc.Key="texttovideo.insertTo" loc:Loc.ToolTipKey="texttovideo.insertToTooltip" />
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.EditorToTimeHint, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.timeFormatHint" TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" loc:Loc.HeaderKey="texttovideo.animation" SelectedIndex="{x:Bind ViewModel.EditorAnimationIndex, Mode=TwoWay}">
                                    <ComboBoxItem loc:Loc.Key="texttovideo.anim.none" />
                                    <ComboBoxItem loc:Loc.Key="texttovideo.anim.fade" />
                                    <ComboBoxItem loc:Loc.Key="texttovideo.anim.slide" />
                                    <ComboBoxItem loc:Loc.Key="texttovideo.anim.pop" />
                                </ComboBox>
                                <NumberBox Grid.Column="1" loc:Loc.HeaderKey="texttovideo.animDuration" Minimum="0.05" Maximum="5" SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EditorSegment.AnimDuration, Mode=TwoWay}" />
                            </Grid>
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" loc:Loc.HeaderKey="texttovideo.effectsHeader">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.outlineWidth" Maximum="40" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EditorSegment.OutlineWidth, Mode=TwoWay}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock loc:Loc.Key="texttovideo.outlineColor" />
                                            <controls:HexColorField Hex="{x:Bind ViewModel.EditorSegment.OutlineColor, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox loc:Loc.Key="texttovideo.shadow" IsChecked="{x:Bind ViewModel.EditorSegment.Shadow, Mode=TwoWay}" />
                                    <CheckBox loc:Loc.Key="texttovideo.textBackground" IsChecked="{x:Bind ViewModel.EditorSegment.BoxEnabled, Mode=TwoWay}" />
                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.EditorSegment.BoxEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Spacing="4">
                                            <TextBlock loc:Loc.Key="texttovideo.boxColor" />
                                            <controls:HexColorField Hex="{x:Bind ViewModel.EditorSegment.BoxColor, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Slider loc:Loc.HeaderKey="texttovideo.boxOpacity" Maximum="100" Minimum="0" StepFrequency="5" Value="{x:Bind ViewModel.EditorSegment.BoxOpacity, Mode=TwoWay}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.boxRadius" Maximum="200" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EditorSegment.BoxRadius, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="1" loc:Loc.HeaderKey="texttovideo.padding" Maximum="40" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EditorSegment.BoxBorder, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" loc:Loc.HeaderKey="texttovideo.advancedOptions">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.fontFile" Text="{x:Bind ViewModel.EditorSegment.FontPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickFontCommand}" loc:Loc.Key="common.addDots" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.italicFont" Text="{x:Bind ViewModel.EditorSegment.ItalicFontPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickItalicFontCommand}" loc:Loc.Key="common.addDots" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.batchHeader" />
                        </Expander.Header>
                        <StackPanel Padding="0,8,0,0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.PickBatchVideosCommand}" loc:Loc.Key="texttovideo.batchVideos" />
                                <Button Command="{x:Bind ViewModel.ScanBatchFolderCommand}" loc:Loc.Key="bitrate.scanFolder" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.RemoveSelectedBatchRowsCommand}" loc:Loc.Key="datensync.removeSelection" />
                                <Button Command="{x:Bind ViewModel.ClearBatchCommand}" loc:Loc.Key="common.clearList" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.batchOutputDir" Text="{x:Bind ViewModel.BatchOutputDir, Mode=TwoWay}" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickBatchOutputDirCommand}" loc:Loc.Key="common.folder" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.BatchRows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TextToVideoBatchRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Status}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{x:Bind ViewModel.ExportBatchCommand}" Content="{x:Bind ViewModel.BatchExportLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Expander>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.subtitlesOptional" />
                        </Expander.Header>
                        <StackPanel Padding="0,8,0,0" Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.srtPath" Text="{x:Bind ViewModel.SrtPath, Mode=TwoWay}" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickSrtCommand}" loc:Loc.Key="texttovideo.srtPick" />
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ClearSrtCommand}" loc:Loc.Key="common.remove" />
                            </Grid>
                            <Button Command="{x:Bind ViewModel.ImportSrtToSegmentsCommand}" loc:Loc.Key="texttovideo.importSrt" />
                        </StackPanel>
                    </Expander>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.export" />
                        </Expander.Header>
                        <StackPanel Padding="0,8,0,0" Spacing="8">
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.container" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind ViewModel.ContainerChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ExportContainer, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.codec" />
                                <ComboBox Grid.Row="1" Grid.Column="1" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.CodecChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Codec, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.bitrate" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="120" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" Text="{x:Bind ViewModel.Bitrate, Mode=TwoWay}" />
                                    <Button Command="{x:Bind ViewModel.ApplySourceBitrateCommand}" loc:Loc.Key="bitrate.colSource" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.targetFps" />
                                <NumberBox Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="240" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" Value="{x:Bind ViewModel.TargetFps, Mode=TwoWay}" />
                                <CheckBox Grid.Row="4" Grid.Column="1" loc:Loc.Key="texttovideo.audioCopyMp4" IsChecked="{x:Bind ViewModel.AudioCopy, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8" RowSpacing="8" Visibility="{x:Bind ViewModel.IsGifExport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" loc:Loc.Key="texttovideo.gifFps" />
                                <NumberBox Grid.Row="0" Grid.Column="1" Maximum="60" Minimum="1" Value="{x:Bind ViewModel.GifFps, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" loc:Loc.Key="texttovideo.gifMaxWidth" />
                                <NumberBox Grid.Row="1" Grid.Column="1" Maximum="1920" Minimum="160" Value="{x:Bind ViewModel.GifMaxWidth, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" loc:Loc.Key="texttovideo.paletteColors" />
                                <NumberBox Grid.Row="2" Grid.Column="1" Maximum="256" Minimum="8" Value="{x:Bind ViewModel.GifPaletteColors, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.ExportCommand}" loc:Loc.Key="texttovideo.exportFfmpeg" Style="{StaticResource AccentButtonStyle}" />
                                <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" loc:Loc.Key="common.save" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.davinciSection" />
                        </Expander.Header>
                        <StackPanel Padding="0,8,0,0" Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.davinciHint" TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="texttovideo.renderPreset" />
                                <TextBox Grid.Row="0" Grid.Column="1" loc:Loc.PlaceholderKey="texttovideo.presetPlaceholder" Text="{x:Bind ViewModel.DavinciPreset, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="texttovideo.outputDir" />
                                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" loc:Loc.PlaceholderKey="texttovideo.outputDirDefault" Text="{x:Bind ViewModel.DavinciOutputDir, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.PickDavinciOutputDirCommand}" loc:Loc.Key="common.folder" />
                                </Grid>
                            </Grid>
                            <CheckBox loc:Loc.Key="texttovideo.useLastFfmpeg" IsChecked="{x:Bind ViewModel.UseLastFfmpegForResolve, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HasLastFfmpegOutput, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.LastFfmpegOutput, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <Button Command="{x:Bind ViewModel.ExportResolveCommand}" loc:Loc.Key="texttovideo.exportResolve" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </controls:ToolSplitLayout.Settings>
        </controls:ToolSplitLayout>
</UserControl>
