<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.TextToVideoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HailMary.Models"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    mc:Ignorable="d" xmlns:loc="using:HailMary.Services">

    <ContentControl IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
        <StackPanel
            Style="{StaticResource ToolShellContentPanel}"
            MaxWidth="{StaticResource HmContentWidthWide}"
            HorizontalAlignment="Stretch"
            Spacing="10">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.Setters>
                            <Setter Target="MainRightColumn.Width" Value="0" />
                            <Setter Target="MainRight.(Grid.Column)" Value="0" />
                            <Setter Target="MainRight.(Grid.Row)" Value="1" />
                            <Setter Target="LowerRightColumn.Width" Value="0" />
                            <Setter Target="DavinciCard.(Grid.Column)" Value="0" />
                            <Setter Target="DavinciCard.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1180" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MainRightColumn.Width" Value="*" />
                            <Setter Target="MainRight.(Grid.Column)" Value="1" />
                            <Setter Target="MainRight.(Grid.Row)" Value="0" />
                            <Setter Target="LowerRightColumn.Width" Value="*" />
                            <Setter Target="DavinciCard.(Grid.Column)" Value="1" />
                            <Setter Target="DavinciCard.(Grid.Row)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="WrapWholeWords" />

            <Grid ColumnSpacing="12" RowSpacing="10" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="MainRightColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ToolShellCard}" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.video" />
                        <Grid ColumnSpacing="8" drop:VideoDrop.IsEnabled="True" drop:VideoDrop.PathPropertyName="VideoPath">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.videoPath" Text="{x:Bind ViewModel.VideoPath, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickVideoCommand}" loc:Loc.Key="common.addDots" />
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.VideoInfoLine, Mode=OneWay}" />
                        <controls:TextToVideoPreviewHost ViewModel="{x:Bind ViewModel, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasVideo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="MainRight" Grid.Column="0" Grid.Row="1" Spacing="10" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource ToolShellCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.segmentsHeader" />
                            <ListView
                                x:Name="SegmentList"
                                MaxHeight="160"
                                ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}"
                                SelectionChanged="SegmentList_OnSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TextOverlaySegment">
                                        <TextBlock Text="{x:Bind ListLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    Width="40"
                                    Height="36"
                                    Command="{x:Bind ViewModel.NewSegmentCommand}"
                                    loc:Loc.ToolTipKey="texttovideo.newSegment">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE710;" />
                                </Button>
                                <Button
                                    Width="40"
                                    Height="36"
                                    Command="{x:Bind ViewModel.DuplicateSegmentCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsEditingExistingSegment, Mode=OneWay}"
                                    loc:Loc.ToolTipKey="texttovideo.duplicateSegment">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8C8;" />
                                </Button>
                                <Button
                                    Width="40"
                                    Height="36"
                                    Command="{x:Bind ViewModel.DeleteSegmentCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsEditingExistingSegment, Mode=OneWay}"
                                    loc:Loc.ToolTipKey="common.delete">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE738;" />
                                </Button>
                                <Button
                                    Width="40"
                                    Height="36"
                                    Command="{x:Bind ViewModel.CommitSegmentCommand}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.CommitSegmentLabel, Mode=OneWay}">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8FB;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolShellCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource ToolShellSectionHeader}" Text="{x:Bind ViewModel.SegmentEditorTitle, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SegmentModeHint, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Opacity="0.85" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    AcceptsReturn="True"
                                    loc:Loc.HeaderKey="texttovideo.textHeader"
                                    MaxHeight="100"
                                    Text="{x:Bind ViewModel.EditorSegment.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.PasteTextCommand}"
                                    loc:Loc.Key="common.insert" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.stylePresets" />
                                <StackPanel x:Name="StylePresetPanel" Orientation="Vertical" Spacing="6" />
                            </StackPanel>
                            <NumberBox
                                loc:Loc.HeaderKey="texttovideo.fontSize"
                                Maximum="200"
                                Minimum="12"
                                Value="{x:Bind ViewModel.EditorSegment.Fontsize, Mode=TwoWay}" />
                            <TextBox
                                loc:Loc.HeaderKey="texttovideo.color"
                                Text="{x:Bind ViewModel.EditorSegment.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.position" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Maximum="20000" Minimum="0" Value="{x:Bind ViewModel.EditorSegment.PosX, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Maximum="20000" Minimum="0" Value="{x:Bind ViewModel.EditorSegment.PosY, Mode=TwoWay}" />
                            </Grid>
                            <NumberBox
                                loc:Loc.HeaderKey="texttovideo.lineSpacing"
                                Maximum="120"
                                Minimum="-120"
                                Value="{x:Bind ViewModel.EditorSegment.LineSpacing, Mode=TwoWay}" />
                            <ComboBox
                                x:Name="FontCombo"
                                HorizontalAlignment="Stretch"
                                loc:Loc.HeaderKey="texttovideo.fontFamily"
                                IsEditable="False"
                                IsTextSearchEnabled="True"
                                SelectionChanged="FontCombo_OnSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:WindowsFontChoice" xmlns:svc="using:HailMary.Services">
                                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="texttovideo.timeFromTo" TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    loc:Loc.PlaceholderKey="texttovideo.timePlaceholder"
                                    Text="{x:Bind ViewModel.EditorSegment.From, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Click="InsertFrom_Click"
                                    loc:Loc.Key="texttovideo.insertFrom"
                                    loc:Loc.ToolTipKey="texttovideo.insertFromTooltip" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.EditorFromTimeHint, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    loc:Loc.PlaceholderKey="texttovideo.timePlaceholder"
                                    Text="{x:Bind ViewModel.EditorSegment.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Click="InsertTo_Click"
                                    loc:Loc.Key="texttovideo.insertTo"
                                    loc:Loc.ToolTipKey="texttovideo.insertToTooltip" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.EditorToTimeHint, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                loc:Loc.Key="texttovideo.timeFormatHint"
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox loc:Loc.Key="common.bold" IsChecked="{x:Bind ViewModel.EditorSegment.Bold, Mode=TwoWay}" Margin="0,0,12,4" />
                                <CheckBox loc:Loc.Key="common.italic" IsChecked="{x:Bind ViewModel.EditorSegment.Italic, Mode=TwoWay}" Margin="0,0,12,4" />
                                <CheckBox loc:Loc.Key="common.strike" IsChecked="{x:Bind ViewModel.EditorSegment.Strike, Mode=TwoWay}" Margin="0,0,12,4" />
                                <CheckBox loc:Loc.Key="texttovideo.textBackground" IsChecked="{x:Bind ViewModel.EditorSegment.BoxEnabled, Mode=TwoWay}" Margin="0,0,0,4" />
                            </StackPanel>
                            <StackPanel x:Name="ColorPalettePanel" Orientation="Horizontal" Spacing="6" />
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" loc:Loc.HeaderKey="texttovideo.advancedOptions">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.fontFile" Text="{x:Bind ViewModel.EditorSegment.FontPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickFontCommand}" loc:Loc.Key="common.addDots" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.italicFont" Text="{x:Bind ViewModel.EditorSegment.ItalicFontPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickItalicFontCommand}" loc:Loc.Key="common.addDots" />
                                    </Grid>
                                    <NumberBox
                                        loc:Loc.HeaderKey="texttovideo.padding"
                                        Maximum="40"
                                        Minimum="0"
                                        Value="{x:Bind ViewModel.EditorSegment.BoxBorder, Mode=TwoWay}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ToolShellCard}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.subtitlesOptional" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.srtPath" Text="{x:Bind ViewModel.SrtPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickSrtCommand}" loc:Loc.Key="texttovideo.srtPick" />
                        <Button Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ClearSrtCommand}" loc:Loc.Key="common.remove" />
                    </Grid>
                    <Button Command="{x:Bind ViewModel.ImportSrtToSegmentsCommand}" loc:Loc.Key="texttovideo.importSrt" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolShellCard}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.batchHeader" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.PickBatchVideosCommand}" loc:Loc.Key="texttovideo.batchVideos" />
                        <Button Command="{x:Bind ViewModel.ScanBatchFolderCommand}" loc:Loc.Key="bitrate.scanFolder" />
                        <Button Command="{x:Bind ViewModel.RemoveSelectedBatchRowsCommand}" loc:Loc.Key="datensync.removeSelection" />
                        <Button Command="{x:Bind ViewModel.ClearBatchCommand}" loc:Loc.Key="common.clearList" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="texttovideo.batchOutputDir" Text="{x:Bind ViewModel.BatchOutputDir, Mode=TwoWay}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickBatchOutputDirCommand}" loc:Loc.Key="common.folder" />
                    </Grid>
                    <ListView MaxHeight="160" ItemsSource="{x:Bind ViewModel.BatchRows, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TextToVideoBatchRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Command="{x:Bind ViewModel.ExportBatchCommand}" Content="{x:Bind ViewModel.BatchExportLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="LowerRightColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ToolShellCard}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.export" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.container" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind ViewModel.ContainerChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ExportContainer, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.codec" />
                        <ComboBox Grid.Row="1" Grid.Column="1" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.CodecChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Codec, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.bitrate" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Width="120" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" Text="{x:Bind ViewModel.Bitrate, Mode=TwoWay}" />
                            <Button Command="{x:Bind ViewModel.ApplySourceBitrateCommand}" loc:Loc.Key="bitrate.colSource" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.targetFps" />
                        <NumberBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="240"
                            SmallChange="1"
                            LargeChange="5"
                            SpinButtonPlacementMode="Compact"
                            IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}"
                            Value="{x:Bind ViewModel.TargetFps, Mode=TwoWay}" />
                        <CheckBox Grid.Row="4" Grid.Column="1" loc:Loc.Key="texttovideo.audioCopyMp4" IsChecked="{x:Bind ViewModel.AudioCopy, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsMp4Export, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnSpacing="8" RowSpacing="8" Visibility="{x:Bind ViewModel.IsGifExport, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" loc:Loc.Key="texttovideo.gifFps" />
                        <NumberBox Grid.Row="0" Grid.Column="1" Maximum="60" Minimum="1" Value="{x:Bind ViewModel.GifFps, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" loc:Loc.Key="texttovideo.gifMaxWidth" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Maximum="1920" Minimum="160" Value="{x:Bind ViewModel.GifMaxWidth, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" loc:Loc.Key="texttovideo.paletteColors" />
                        <NumberBox Grid.Row="2" Grid.Column="1" Maximum="256" Minimum="8" Value="{x:Bind ViewModel.GifPaletteColors, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.ExportCommand}" loc:Loc.Key="texttovideo.exportFfmpeg" Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" loc:Loc.Key="common.save" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="DavinciCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource ToolShellCard}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="texttovideo.davinciSection" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        loc:Loc.Key="texttovideo.davinciHint"
                        TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="texttovideo.renderPreset" />
                        <TextBox Grid.Row="0" Grid.Column="1" loc:Loc.PlaceholderKey="texttovideo.presetPlaceholder" Text="{x:Bind ViewModel.DavinciPreset, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="texttovideo.outputDir" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" loc:Loc.PlaceholderKey="texttovideo.outputDirDefault" Text="{x:Bind ViewModel.DavinciOutputDir, Mode=TwoWay}" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.PickDavinciOutputDirCommand}" loc:Loc.Key="common.folder" />
                        </Grid>
                    </Grid>
                    <CheckBox
                        loc:Loc.Key="texttovideo.useLastFfmpeg"
                        IsChecked="{x:Bind ViewModel.UseLastFfmpegForResolve, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasLastFfmpegOutput, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.LastFfmpegOutput, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button Command="{x:Bind ViewModel.ExportResolveCommand}" loc:Loc.Key="texttovideo.exportResolve" />
                </StackPanel>
            </Border>
            </Grid>
        </StackPanel>
    </ContentControl>
</UserControl>
