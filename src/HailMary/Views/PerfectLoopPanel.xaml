<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.PerfectLoopPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:drop="using:HailMary.Views.Helpers"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    mc:Ignorable="d">

    <Grid
        MaxWidth="{StaticResource HmContentWidthStandard}"
        Padding="{StaticResource HmContentPadding}"
        HorizontalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsColumn.(Grid.Column)" Value="1" />
                        <Setter Target="SettingsColumn.(Grid.Row)" Value="0" />
                        <Setter Target="SettingsColumnDefinition.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="10">

            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.QualityHint, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsColumnDefinition" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="16">
            <Border Style="{StaticResource ToolShellCard}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="perfectloop.inputHeader" />
                    <Grid ColumnSpacing="8" drop:VideoDrop.AllowFolders="True" drop:VideoDrop.IsEnabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" loc:Loc.PlaceholderKey="perfectloop.inputPlaceholder" Text="{x:Bind ViewModel.InputPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.PickInputFileCommand}" loc:Loc.Key="common.file" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.PickInputFolderCommand}" loc:Loc.Key="common.folder" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolShellCard}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="perfectloop.filesHeader" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.BatchSummary, Mode=OneWay}" />
                    <ListView
                        MaxHeight="100"
                        ItemsSource="{x:Bind ViewModel.BatchFiles, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock FontFamily="Consolas" Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" loc:Loc.HeaderKey="perfectloop.outputDirHeader" Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickOutputDirCommand}" loc:Loc.Key="common.addDots" />
                    </Grid>
                    <TextBox loc:Loc.HeaderKey="perfectloop.outputPreview" IsReadOnly="True" Text="{x:Bind ViewModel.OutputPath, Mode=OneWay}" />
                </StackPanel>
            </Border>
                </StackPanel>
                <StackPanel x:Name="SettingsColumn" Grid.Row="1" Grid.Column="0">

            <Border Style="{StaticResource ToolShellCard}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="perfectloop.settingsHeader" />
                    <ComboBox
                        loc:Loc.HeaderKey="perfectloop.methodLabel"
                        ItemsSource="{x:Bind ViewModel.SeamMethodOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedSeamMethod, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        loc:Loc.Key="perfectloop.methodHint"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{x:Bind ViewModel.SeamSecondsLabel, Mode=OneWay}" />
                    <Slider
                        Minimum="0.05"
                        Maximum="0.80"
                        StepFrequency="0.05"
                        TickFrequency="0.05"
                        SnapsTo="StepValues"
                        IsEnabled="{x:Bind ViewModel.SeamSliderEnabled, Mode=OneWay}"
                        Value="{x:Bind ViewModel.SeamSeconds, Mode=TwoWay}" />
                    <CheckBox
                        loc:Loc.Key="perfectloop.smartTrim"
                        IsChecked="{x:Bind ViewModel.SmartTrim, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        loc:Loc.Key="perfectloop.smartTrimHint"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        loc:Loc.Key="perfectloop.scoreSeamNote"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        Command="{x:Bind ViewModel.AnalyzeCommand}"
                        Content="{x:Bind ViewModel.AnalyzeButtonLabel, Mode=OneWay}" />
                    <ComboBox
                        loc:Loc.HeaderKey="perfectloop.encoderLabel"
                        ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedEncoder, Mode=TwoWay}" />
                    <NumberBox
                        loc:Loc.HeaderKey="common.targetFps"
                        Minimum="0"
                        Maximum="240"
                        SmallChange="1"
                        LargeChange="5"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.TargetFps, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        loc:Loc.Key="common.targetFpsHint"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
