<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.StashPathfinderPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <controls:ToolSplitLayout SettingsWidth="380">
        <controls:ToolSplitLayout.Main>
            <StackPanel Padding="16,12" Spacing="10">
                <Border Style="{StaticResource ToolShellCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="stashpathfinder.searchHeader" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ConnectionInfo, Mode=OneWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" loc:Loc.HeaderKey="common.searchScene" KeyDown="SearchBox_OnKeyDown" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SearchCommand}" loc:Loc.Key="common.search" />
                        </Grid>
                        <TextBox loc:Loc.HeaderKey="common.sceneId" KeyDown="SceneIdBox_OnKeyDown" Text="{x:Bind ViewModel.SceneId, Mode=TwoWay}" />
                        <StackPanel Spacing="8">
                            <Button
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadSceneCommand}"
                                loc:Loc.Key="common.load" />
                            <Button
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadFromSessionCommand}"
                                loc:Loc.Key="common.lastScene"
                                loc:Loc.ToolTipKey="stash.lastSceneTooltip" />
                            <Button
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadFromClipboardCommand}"
                                loc:Loc.Key="common.clipboard" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolShellCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.results" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="stash.resultsHint" />
                        <ListView
                            x:Name="ResultsList"
                            MinHeight="200"
                            MaxHeight="420"
                            DoubleTapped="ResultsList_OnDoubleTapped"
                            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                            SelectionChanged="ResultsList_OnSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:StashSceneRowViewModel" xmlns:viewModels="using:HailMary.ViewModels">
                                    <TextBlock FontFamily="Consolas" Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:ToolSplitLayout.Main>
        <controls:ToolSplitLayout.Settings>
            <StackPanel Padding="16,12" Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.paths" />
                    </Expander.Header>
                    <StackPanel Padding="0,8,0,0" Spacing="8">
                        <Button Command="{x:Bind ViewModel.ReloadLoadedCommand}" loc:Loc.Key="stash.reloadLoaded" HorizontalAlignment="Left" />
                        <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.LoadedSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        <Button Command="{x:Bind ViewModel.CopyFolderPathCommand}" loc:Loc.Key="common.copyFolder" HorizontalAlignment="Stretch" />
                        <Button Command="{x:Bind ViewModel.CopyFilenameCommand}" loc:Loc.Key="common.copyFilename" HorizontalAlignment="Stretch" />
                        <Button Command="{x:Bind ViewModel.CopyFullPathCommand}" loc:Loc.Key="common.copyFullPath" HorizontalAlignment="Stretch" />
                        <Button Command="{x:Bind ViewModel.OpenExplorerCommand}" loc:Loc.Key="common.explorer" HorizontalAlignment="Stretch" />
                        <Button Command="{x:Bind ViewModel.OpenInStashCommand}" loc:Loc.Key="common.inStash" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </controls:ToolSplitLayout.Settings>
    </controls:ToolSplitLayout>
</UserControl>
