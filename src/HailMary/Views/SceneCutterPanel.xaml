<?xml version="1.0" encoding="utf-8" ?>

<UserControl

    x:Class="HailMary.Views.SceneCutterPanel"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:drop="using:HailMary.Views.Helpers"

    HorizontalAlignment="Stretch"

    VerticalAlignment="Top"

    mc:Ignorable="d" xmlns:loc="using:HailMary.Services">



    <Grid
        MaxWidth="{StaticResource HmContentWidthWide}"
        Padding="{StaticResource HmContentPadding}"
        HorizontalAlignment="Stretch"
        RowSpacing="10">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OutputField.(Grid.Column)" Value="1" />
                        <Setter Target="OutputField.(Grid.Row)" Value="0" />
                        <Setter Target="OutputColumnDefinition.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>



        <Border Grid.Row="0" Style="{StaticResource ToolShellCard}">

            <StackPanel Spacing="8">

                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="common.video" />

                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="OutputColumnDefinition" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8" drop:VideoDrop.IsEnabled="True">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" VerticalAlignment="Bottom" loc:Loc.PlaceholderKey="cutter.videoPlaceholder" Text="{x:Bind ViewModel.InputPath, Mode=TwoWay}" />

                    <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickInputFileCommand}" loc:Loc.Key="common.file" />

                </Grid>

                <Grid x:Name="OutputField" Grid.Row="1" Grid.Column="0" ColumnSpacing="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" loc:Loc.HeaderKey="cutter.outputDirHeader" Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}" />

                    <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PickOutputDirCommand}" loc:Loc.Key="common.addDots" />

                </Grid>
                </Grid>

            </StackPanel>

        </Border>



        <ContentControl

            x:Name="ScenesHost"

            Grid.Row="1"

            HorizontalAlignment="Stretch"

            VerticalAlignment="Stretch"

            HorizontalContentAlignment="Stretch"

            VerticalContentAlignment="Stretch" />

    </Grid>

</UserControl>


