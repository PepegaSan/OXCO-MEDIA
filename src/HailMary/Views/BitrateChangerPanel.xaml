<?xml version="1.0" encoding="utf-8" ?>

<UserControl

    x:Class="HailMary.Views.BitrateChangerPanel"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:HailMary.Views.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d" xmlns:loc="using:HailMary.Services">

    <controls:ToolSplitLayout SettingsWidth="380">
        <controls:ToolSplitLayout.Main>
    <StackPanel
        Padding="16,12"
        HorizontalAlignment="Stretch"
        Spacing="10">



            <Border Style="{StaticResource ToolShellCard}">

                <StackPanel Spacing="8">

                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="autotagger.foldersHeader" />

                    <Grid ColumnSpacing="8" RowSpacing="8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="120" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>

                            <RowDefinition />

                            <RowDefinition />

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="audiocleaner.inputHeader" />

                        <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.InputFolder, Mode=TwoWay}" />

                        <Button Grid.Row="0" Grid.Column="2" Command="{x:Bind ViewModel.PickInputFolderCommand}" loc:Loc.Key="common.addDots" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="bitrate.outputLabel" />

                        <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay}" />

                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">

                            <Button Command="{x:Bind ViewModel.PickOutputFolderCommand}" loc:Loc.Key="common.addDots" />

                            <Button Command="{x:Bind ViewModel.AutoOutputCommand}" loc:Loc.Key="common.auto" />

                        </StackPanel>

                    </Grid>

                    <CheckBox loc:Loc.Key="bitrate.outputBesideSource" IsChecked="{x:Bind ViewModel.OutputBesideSource, Mode=TwoWay}" />

                </StackPanel>

            </Border>



            <Border Style="{StaticResource ToolShellCard}">

                <StackPanel Spacing="8">

                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="bitrate.renameHeader" />

                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        loc:Loc.Key="bitrate.renameHint"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel Orientation="Horizontal" Spacing="6">

                        <Button Command="{x:Bind ViewModel.PreviewRenamesCommand}" loc:Loc.Key="common.preview" />

                        <Button Command="{x:Bind ViewModel.StripSuffixNowCommand}" loc:Loc.Key="bitrate.stripSuffixNow" />

                    </StackPanel>

                </StackPanel>

            </Border>



            <Border Style="{StaticResource ToolShellCard}">

                <StackPanel Spacing="8">

                    <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="bitrate.rulesHeader" />

                    <Grid ColumnSpacing="8" RowSpacing="4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Header="2160p" Text="{x:Bind ViewModel.Rule2160, Mode=TwoWay}" />

                        <TextBox Grid.Row="0" Grid.Column="1" Header="1440p" Text="{x:Bind ViewModel.Rule1440, Mode=TwoWay}" />

                        <TextBox Grid.Row="1" Grid.Column="0" Header="1080p" Text="{x:Bind ViewModel.Rule1080, Mode=TwoWay}" />

                        <TextBox Grid.Row="1" Grid.Column="1" Header="720p" Text="{x:Bind ViewModel.Rule720, Mode=TwoWay}" />

                        <TextBox Grid.Row="2" Grid.Column="0" Header="480p" Text="{x:Bind ViewModel.Rule480, Mode=TwoWay}" />

                        <TextBox Grid.Row="2" Grid.Column="1" Header="360p" Text="{x:Bind ViewModel.Rule360, Mode=TwoWay}" />

                        <TextBox Grid.Row="3" Grid.Column="0" Header="&lt;360p" Text="{x:Bind ViewModel.Rule0, Mode=TwoWay}" />

                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="6">

                        <ComboBox MinWidth="180" ItemsSource="{x:Bind ViewModel.PresetOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}" />

                        <Button Command="{x:Bind ViewModel.LoadPresetCommand}" loc:Loc.Key="bitrate.loadPreset" />

                    </StackPanel>

                </StackPanel>

            </Border>



            <Border Style="{StaticResource ToolShellCard}">

                <StackPanel Spacing="8">

                    <StackPanel Orientation="Horizontal" Spacing="6">

                        <Button Command="{x:Bind ViewModel.ScanCommand}" loc:Loc.Key="bitrate.scanFolder" />

                        <Button Command="{x:Bind ViewModel.MarkAllRowsCommand}" loc:Loc.Key="common.markAll" />

                        <Button Command="{x:Bind ViewModel.UnmarkAllRowsCommand}" loc:Loc.Key="common.unmarkAll" />

                    </StackPanel>

                    <TextBlock

                        Style="{StaticResource CaptionTextBlockStyle}"

                        loc:Loc.Key="bitrate.scanHintFull" />

                    <ListView MinHeight="220" MaxHeight="420" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.Header>
                            <Grid Padding="4,0,4,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="✓" />

                                <TextBlock Grid.Column="1" FontWeight="SemiBold" loc:Loc.Key="bitrate.colFile" />

                                <TextBlock Grid.Column="2" FontWeight="SemiBold" loc:Loc.Key="bitrate.colResolution" />

                                <TextBlock Grid.Column="3" FontWeight="SemiBold" loc:Loc.Key="bitrate.colCodec" />

                                <TextBlock Grid.Column="4" FontWeight="SemiBold" loc:Loc.Key="bitrate.colSource" />

                                <TextBlock Grid.Column="5" FontWeight="SemiBold" loc:Loc.Key="bitrate.colTarget" />

                                <Button
                                    Grid.Column="6"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.SortRowsBySaveMbCommand, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    loc:Loc.Key="bitrate.colSaveMb" />

                                <TextBlock Grid.Column="7" FontWeight="SemiBold" loc:Loc.Key="bitrate.colAction" />

                                <TextBlock Grid.Column="8" FontWeight="SemiBold" loc:Loc.Key="bitrate.colReason" />
                            </Grid>
                        </ListView.Header>

                        <ListView.ItemTemplate>

                            <DataTemplate x:DataType="viewmodels:BitrateRowViewModel" xmlns:viewmodels="using:HailMary.ViewModels">

                                <Grid Padding="4,0" ColumnSpacing="8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="36" />

                                        <ColumnDefinition Width="2*" />

                                        <ColumnDefinition Width="68" />

                                        <ColumnDefinition Width="60" />

                                        <ColumnDefinition Width="56" />

                                        <ColumnDefinition Width="48" />

                                        <ColumnDefinition Width="56" />

                                        <ColumnDefinition Width="72" />

                                        <ColumnDefinition Width="1.2*" />

                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind Path}" />

                                    <TextBlock Grid.Column="2" Text="{x:Bind Resolution}" TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="3" Text="{x:Bind VideoCodec}" TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="4" Text="{x:Bind SourceKbps}" TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="5" Text="{x:Bind TargetKbps}" TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="6" Text="{x:Bind EstSaveMb}" TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="7" Text="{x:Bind Action}" TextWrapping="NoWrap" />

                                    <TextBlock
                                        Grid.Column="8"
                                        Text="{x:Bind Reason}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind Reason}" />

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </StackPanel>

            </Border>

        </StackPanel>
        </controls:ToolSplitLayout.Main>
        <controls:ToolSplitLayout.Settings>
            <StackPanel Padding="16,12" Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolShellSectionHeader}"
                        loc:Loc.Key="bitrate.optionsHeader" />
                    <Button
                        Grid.Column="1"
                        Padding="8,4"
                        Click="ScenarioHelp_Click"
                        loc:Loc.ToolTipKey="bitrate.scenarioHelpTooltip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE946;" />
                            <TextBlock VerticalAlignment="Center" loc:Loc.Key="bitrate.scenarioHelpButton" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- What to look for -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="16" Glyph="&#xE721;" />
                            <TextBlock loc:Loc.Key="bitrate.section.scan" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            loc:Loc.HeaderKey="bitrate.scanModeHeader"
                            SelectedIndex="{x:Bind ViewModel.ScanModeIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Key="bitrate.scanMode.bitrate" />
                            <ComboBoxItem loc:Loc.Key="bitrate.scanMode.problemCodecs" />
                            <ComboBoxItem loc:Loc.Key="bitrate.scanMode.bitrateOrCodecs" />
                        </ComboBox>
                        <TextBlock
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            loc:Loc.Key="bitrate.scanModeHint"
                            TextWrapping="WrapWholeWords" />
                        <CheckBox loc:Loc.Key="bitrate.scanSubfolders" IsChecked="{x:Bind ViewModel.Recursive, Mode=TwoWay}" />
                        <CheckBox loc:Loc.Key="bitrate.onlyLower" IsChecked="{x:Bind ViewModel.OnlyLower, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>

                <!-- How to encode -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="16" Glyph="&#xE714;" />
                            <TextBlock loc:Loc.Key="bitrate.section.encode" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                loc:Loc.HeaderKey="audiocleaner.videoCodec"
                                ItemsSource="{x:Bind ViewModel.CodecOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedCodec, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                loc:Loc.HeaderKey="oxco.audioHeader"
                                SelectedIndex="{x:Bind ViewModel.AudioModeIndex, Mode=TwoWay}">
                                <ComboBoxItem loc:Loc.Key="bitrate.audio.copy" />
                                <ComboBoxItem loc:Loc.Key="bitrate.audio.aac" />
                            </ComboBox>
                        </Grid>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            loc:Loc.HeaderKey="bitrate.rateControlHeader"
                            loc:Loc.ToolTipKey="bitrate.rateControlHint"
                            SelectedIndex="{x:Bind ViewModel.RateControlIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Key="bitrate.rateControl.auto" />
                            <ComboBoxItem loc:Loc.Key="bitrate.rateControl.bitrate" />
                            <ComboBoxItem loc:Loc.Key="bitrate.rateControl.crf" />
                        </ComboBox>
                        <Grid
                            ColumnSpacing="8"
                            Visibility="{x:Bind ViewModel.ShowCrfControls, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                loc:Loc.HeaderKey="bitrate.crfPresetHeader"
                                loc:Loc.ToolTipKey="bitrate.crfHint"
                                SelectedIndex="{x:Bind ViewModel.CrfPresetIndex, Mode=TwoWay}">
                                <ComboBoxItem loc:Loc.Key="bitrate.crfPreset.quality" />
                                <ComboBoxItem loc:Loc.Key="bitrate.crfPreset.balanced" />
                                <ComboBoxItem loc:Loc.Key="bitrate.crfPreset.compact" />
                                <ComboBoxItem loc:Loc.Key="bitrate.crfPreset.tiny" />
                            </ComboBox>
                            <NumberBox
                                Grid.Column="1"
                                loc:Loc.HeaderKey="bitrate.crfValueHeader"
                                Minimum="0"
                                Maximum="51"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.CrfValue, Mode=TwoWay}" />
                        </Grid>
                        <NumberBox
                            loc:Loc.HeaderKey="common.targetFps"
                            loc:Loc.ToolTipKey="common.targetFpsHint"
                            Minimum="0"
                            Maximum="240"
                            SmallChange="1"
                            LargeChange="5"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.TargetFps, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>

                <!-- What happens with the files -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                            <TextBlock loc:Loc.Key="bitrate.section.output" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            loc:Loc.HeaderKey="bitrate.postActionHeader"
                            SelectedIndex="{x:Bind ViewModel.PostActionIndex, Mode=TwoWay}">
                            <ComboBoxItem loc:Loc.Key="bitrate.postAction.keep" />
                            <ComboBoxItem loc:Loc.Key="bitrate.postAction.backup" />
                            <ComboBoxItem loc:Loc.Key="bitrate.postAction.delete" />
                        </ComboBox>
                        <TextBox loc:Loc.HeaderKey="common.suffix" Text="{x:Bind ViewModel.Suffix, Mode=TwoWay}" />
                        <CheckBox loc:Loc.Key="bitrate.outputMp4" IsChecked="{x:Bind ViewModel.OutputMp4, Mode=TwoWay}" />
                        <CheckBox
                            loc:Loc.Key="bitrate.stripAfterSuccess"
                            loc:Loc.ToolTipKey="bitrate.replaceOriginalHint"
                            IsChecked="{x:Bind ViewModel.StripAutobitrateSuffix, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>

                <!-- Machine load, rarely changed -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                            <TextBlock loc:Loc.Key="bitrate.gamingHeader" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                loc:Loc.HeaderKey="bitrate.parallelJobsHeader"
                                Minimum="1"
                                Maximum="8"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.ParallelJobs, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="1"
                                loc:Loc.HeaderKey="bitrate.ffmpegThreadsHeader"
                                Minimum="0"
                                Maximum="64"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.FfmpegThreads, Mode=TwoWay}" />
                        </Grid>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            loc:Loc.HeaderKey="bitrate.x264PresetHeader"
                            ItemsSource="{x:Bind ViewModel.X264PresetOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedX264Preset, Mode=TwoWay}" />
                        <CheckBox loc:Loc.Key="bitrate.lowPriority" IsChecked="{x:Bind ViewModel.LowPriority, Mode=TwoWay}" />
                        <TextBlock
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            loc:Loc.Key="bitrate.gamingHint"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            </StackPanel>
        </controls:ToolSplitLayout.Settings>
    </controls:ToolSplitLayout>

</UserControl>


