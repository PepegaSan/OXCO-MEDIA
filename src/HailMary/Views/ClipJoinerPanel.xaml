<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HailMary.Views.ClipJoinerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HailMary.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:HailMary.ViewModels"
    xmlns:loc="using:HailMary.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <controls:ToolSplitLayout SettingsWidth="380">
        <controls:ToolSplitLayout.Main>
            <StackPanel Padding="16,12" Spacing="10">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                <Border Style="{StaticResource ToolShellCard}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="clipjoiner.clipsHeader" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.8"
                                Text="{x:Bind ViewModel.ClipsSummary, Mode=OneWay}" />
                        </Grid>
                        <Border
                            x:Name="DropZone"
                            Padding="16"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE898;" Opacity="0.7" />
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" loc:Loc.Key="clipjoiner.dropHint" />
                            </StackPanel>
                        </Border>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasMixedSizes, Mode=OneWay}"
                            Severity="Informational"
                            loc:Loc.Key="clipjoiner.mixedSizesHint" />
                        <ListView
                            x:Name="ClipList"
                            MaxHeight="420"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            ItemsSource="{x:Bind ViewModel.ClipRows, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,3" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ClipJoinerClipRow">
                                    <Border
                                        Padding="10,8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE76F;" Opacity="0.5" />
                                            <Border
                                                Grid.Column="1"
                                                MinWidth="28"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Index, Mode=OneWay}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Text="{x:Bind Info, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                                <Button Width="34" Height="32" Padding="0" Click="MoveUp_Click" Tag="{x:Bind}" loc:Loc.ToolTipKey="cutter.moveUp">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE70E;" />
                                                </Button>
                                                <Button Width="34" Height="32" Padding="0" Click="MoveDown_Click" Tag="{x:Bind}" loc:Loc.ToolTipKey="cutter.moveDown">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE70D;" />
                                                </Button>
                                                <Button Width="34" Height="32" Padding="0" Click="Remove_Click" Tag="{x:Bind}" loc:Loc.ToolTipKey="common.remove">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.PickClipsCommand}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE710;" />
                                    <TextBlock loc:Loc.Key="clipjoiner.addButton" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.SortClipsByNameCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE8CB;" />
                                    <TextBlock loc:Loc.Key="clipjoiner.sortByName" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ClearClipsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE74D;" />
                                    <TextBlock loc:Loc.Key="common.clear" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" loc:Loc.Key="clipjoiner.reorderHint" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:ToolSplitLayout.Main>
        <controls:ToolSplitLayout.Settings>
            <StackPanel Padding="16,12" Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="clipjoiner.outputHeader" />
                    </Expander.Header>
                    <StackPanel Padding="0,8,0,0" Spacing="8">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="autotagger.foldersHeader" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}" />
                            <Button Grid.Row="0" Grid.Column="2" Command="{x:Bind ViewModel.PickOutputDirCommand}" Content="…" />
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="clipjoiner.filenameLabel" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.OutputName, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="clipjoiner.modeLabel" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                                <ComboBoxItem loc:Loc.Key="clipjoiner.mode.ffmpeg" />
                                <ComboBoxItem loc:Loc.Key="clipjoiner.mode.davinci" />
                                <ComboBoxItem loc:Loc.Key="clipjoiner.mode.both" />
                            </ComboBox>
                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="perfectloop.encoderLabel" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedEncoder, Mode=TwoWay}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="common.targetFps" />
                            <NumberBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="240" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.TargetFps, Mode=TwoWay}" />
                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" loc:Loc.Key="clipjoiner.davinciPreset" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.DavinciPreset, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" loc:Loc.Key="clipjoiner.davinciPathHint" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Expander>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource ToolShellSectionHeader}" loc:Loc.Key="clipjoiner.batchQueueHeader" />
                    </Expander.Header>
                    <StackPanel Padding="0,8,0,0" Spacing="8">
                        <ListView
                            x:Name="BatchList"
                            MaxHeight="160"
                            ItemsSource="{x:Bind ViewModel.BatchRows, Mode=OneWay}"
                            SelectionChanged="BatchList_OnSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ClipJoinerBatchRow">
                                    <TextBlock Text="{x:Bind Summary}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.AddCurrentToBatchCommand}" loc:Loc.Key="clipjoiner.batchAddCurrent" />
                            <Button Command="{x:Bind ViewModel.RemoveSelectedBatchCommand}" loc:Loc.Key="clipjoiner.batchRemove" />
                            <Button Command="{x:Bind ViewModel.ClearBatchCommand}" loc:Loc.Key="clipjoiner.batchClear" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.RunBatchCommand}" Content="{x:Bind ViewModel.RunBatchLabel, Mode=OneWay}" />
                            <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" loc:Loc.Key="common.save" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </controls:ToolSplitLayout.Settings>
    </controls:ToolSplitLayout>
</UserControl>
